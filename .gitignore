# ============================================================
# IMTIAZ — .gitignore
# ============================================================

# ─── Muhim: Secrets (hech qachon GitHub'ga tushmasin) ────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.Python
pip-log.txt
pip-delete-this-directory.txt

# ─── Virtual Environment ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.bak

# ─── Django ───────────────────────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
local_settings.py
staticfiles/
media/

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
!logs/.gitkeep

# ─── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
nosetests.xml
test-results/

# ─── Celery ───────────────────────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid
*.pid

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── Misc ─────────────────────────────────────────────────────────────────────
schema.yml
*.bak
*.tmp
*.orig
