# ============================================================
# IMTIAZ — Environment Variables
# cp .env.example .env  va kerakli qiymatlarni to'ldiring
# ============================================================

# ─── Django ───────────────────────────────────────────────
SECRET_KEY=your-secret-key-min-50-chars-change-in-production
DEBUG=True
# Production API server (api.medhomee.uz): DEBUG=False, ENABLE_API_DOCS=True
ENABLE_API_DOCS=True
# Swagger Servers: domen ( /api avtomatik qo'shiladi — path trim bilan mos )
API_BASE_URL=https://api.medhomee.uz
ALLOWED_HOSTS=localhost,127.0.0.1,api.medhomee.uz
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://imtiaz-crm.vercel.app

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=https://imtiaz-crm.vercel.app
QR_SCAN_BASE_URL=https://imtiaz-crm.vercel.app/qr/

# ─── Database ─────────────────────────────────────────────
# PostgreSQL — VPS da o'rnatilgan DB parametrlari
DB_NAME=imtiaz_db
DB_USER=imtiaz_user
DB_PASSWORD=PAROLINGIZ
DB_HOST=localhost
DB_PORT=5432

# Local dev uchun SQLite ishlatish (True qiling, production da False)
DB_USE_SQLITE=False

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── JWT ──────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30

# ─── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=        # @BotFather dan oling
TELEGRAM_BOT_SECRET=imtiaz-webhook-secret

# ─── SMS — DevSMS ─────────────────────────────────────────
# https://devsms.uz — Bearer token bilan ishlaydi, login kerak emas
DEVSMS_TOKEN=your-devsms-bearer-token
DEVSMS_BASE_URL=https://devsms.uz/api/send_sms.php

# ─── SMS — Eskiz (o'chirildi, DevSMS ga o'tildi) ──────────
# ESKIZ_EMAIL=your@email.com
# ESKIZ_PASSWORD=your-eskiz-password
# ESKIZ_FROM=IMTIAZ

# ─── AI Providers ─────────────────────────────────────────
# Faol provider: 'gemini' (default) yoki 'claude'
AI_PROVIDER=gemini

# Google Gemini (asosiy)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash     # yoki gemini-2.5-flash-lite (tezroq/arzonroq)

# Anthropic Claude (zaxira)
# https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-5
AI_MAX_TOKENS=1024
AI_FOLLOWUP_MAX_TOKENS=512
AI_HISTORY_LIMIT=12
AI_SKIP_SECOND_CALL=True

# ─── Payment Providers ────────────────────────────────────
# Hozir provayder tanlanmagan — stub rejimida ishlaydi
# Tayyor bo'lganda quyidagilarni to'ldiring:

PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=True

CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

MULTICARD_MERCHANT_ID=
MULTICARD_SECRET_KEY=
MULTICARD_TEST_MODE=True

# ─── External Integrations ────────────────────────────────
AVIAKASSA_API_KEY=
AVIAKASSA_BASE_URL=

RAILWAY_API_KEY=
RAILWAY_BASE_URL=

# Bookhara avia GDS
# Dev: https://avia-api-dev.bookhara.uz
# Prod: https://avia-api.bookhara.uz
BOOKHARA_EMAIL=
BOOKHARA_PASSWORD=
BOOKHARA_BASE_URL=https://avia-api-dev.bookhara.uz
BOOKHARA_WEBHOOK_SECRET=   # Bookhara dashboard'dan oling

# ─── Static / Media ───────────────────────────────────────
STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# ─── AlifPay (mijozdan pul olish) ─────────────────────────
# Sandbox: https://api-sandbox.alifpay.uz/v2  (ALIFPAY_TEST_MODE=True)
# Prod:    https://api.alifpay.uz/v2          (ALIFPAY_TEST_MODE=False)
# Checkout sandbox: https://checkout-dev.alifpay.uz
# Checkout prod:    https://checkout.alifpay.uz
ALIFPAY_TOKEN=          # AlifPay merchant kabinet'dan
ALIFPAY_SECRET_KEY=     # Webhook imzo kaliti (majburiy — DEBUG'dan mustaqil)
ALIFPAY_WEBHOOK_URL=    # https://yourdomain.uz/api/payments/webhook/alifpay/
ALIFPAY_TEST_MODE=True
ALIFPAY_RECEIPT_ENABLED=False   # True bo'lsa ALIFPAY_SPIC majburiy
ALIFPAY_SPIC=                   # soliq.uz IKPU/SPIC kodi (fiskal chek uchun)

# ─── Sentry (production error tracking) ───────────────────
# https://sentry.io — bepul plan bor
SENTRY_DSN=
